@echo off
REM ============================================================
REM  Local private settings for the WSJ -> Kindle daily run.
REM  THIS FILE MUST NEVER BE COMMITTED (see .gitignore).
REM  Only ASCII is used on purpose: cmd.exe misparses UTF-8
REM  comments in .cmd files (this actually bit us once).
REM ============================================================
REM
REM  Fill in these two lines with your own values:
REM    FROM   = the mailbox that owns the SMTP auth code
REM    SECRET = that mailbox's SMTP auth code (NOT the login password)
REM
set FROM=PUT-YOUR-QQ-ADDRESS-HERE@qq.com
set SECRET=PUT-YOUR-SMTP-AUTH-CODE-HERE
REM
REM  The rest is already correct for this machine.
set TO=st1373984942_clTF5y@kindle.com
set SMTP=smtp.qq.com
set PORT=465
set ENCRYPT=SSL
set WSJ_KINDLE_ENABLED=1
